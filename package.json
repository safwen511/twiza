{
  "name": "twiza",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "app"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,app -c blue,green \"npm run dev -w server\" \"npm run dev -w app\"",
    "gen": "tsx data/generate.ts",
    "test": "npm run test -w server",
    "build": "npm run build -w app",
    "satellite": "cd satellite && .venv/bin/python pipeline.py --hex-min-patches 3",
    "start": "npm run build && npm run start -w server"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
