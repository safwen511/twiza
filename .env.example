# ---- Claude (optional). Without a key the assistant and the advice use prepared templates. ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# public link: caps on assistant calls per visitor IP (each call costs money once a key is set)
ASSISTANT_PER_MINUTE=12
ASSISTANT_PER_DAY=200

# ---- server ----
PORT=8787
# domain served by Caddy in docker-compose (its DNS record must point to the server)
DOMAIN=twiza.example.tn
